<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AI Test Automation Suite"
       verbose="1"
       parallel="classes"
       thread-count="3">

    <!-- PetStore Capstone -->
    <test name="Pet Endpoint Tests">
        <classes>
            <class name="com.aitesting.api.petstore.PetTests"/>
        </classes>
    </test>

    <test name="Store Endpoint Tests">
        <classes>
            <class name="com.aitesting.api.petstore.StoreTests"/>
        </classes>
    </test>

    <test name="User Endpoint Tests">
        <classes>
            <class name="com.aitesting.api.petstore.UserTests"/>
        </classes>
    </test>

    <!-- Insurance Capstone - all run against WireMock port 8089 -->
    <test name="Insurance Quote Tests">
        <classes>
            <class name="com.aitesting.api.insurance.QuoteTests"/>
        </classes>
    </test>

    <test name="Insurance Policy Tests">
        <classes>
            <class name="com.aitesting.api.insurance.PolicyTests"/>
        </classes>
    </test>

    <test name="Insurance Claims Tests">
        <classes>
            <class name="com.aitesting.api.insurance.ClaimsTests"/>
        </classes>
    </test>

    <!-- Healthcare Capstone -->
    <test name="Healthcare Patient Tests">
        <classes>
            <class name="com.aitesting.api.healthcare.PatientTests"/>
        </classes>
    </test>

    <test name="Healthcare Encounter Tests">
        <classes>
            <class name="com.aitesting.api.healthcare.EncounterTests"/>
        </classes>
    </test>

    <test name="Healthcare Claim Tests">
        <classes>
            <class name="com.aitesting.api.healthcare.ClaimTests"/>
        </classes>
    </test>

    <test name="Healthcare Prior Auth Tests">
        <classes>
            <class name="com.aitesting.api.healthcare.PriorAuthTests"/>
        </classes>
    </test>

</suite>
