<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AI Test Automation Suite"
       verbose="1"
       parallel="classes"
       thread-count="3">

    <!-- PetStore Capstone -->
    <test name="Pet Endpoint Tests">
        <classes>
            <class name="com.aitesting.petstore.api.PetTests"/>
        </classes>
    </test>

    <test name="Store Endpoint Tests">
        <classes>
            <class name="com.aitesting.petstore.api.StoreTests"/>
        </classes>
    </test>

    <test name="User Endpoint Tests">
        <classes>
            <class name="com.aitesting.petstore.api.UserTests"/>
        </classes>
    </test>

    <!-- Insurance Capstone - all run against WireMock port 8089 -->
    <test name="Insurance Quote Tests">
        <classes>
            <class name="com.aitesting.insurance.api.QuoteTests"/>
        </classes>
    </test>

    <test name="Insurance Policy Tests">
        <classes>
            <class name="com.aitesting.insurance.api.PolicyTests"/>
        </classes>
    </test>

    <test name="Insurance Claims Tests">
        <classes>
            <class name="com.aitesting.insurance.api.ClaimsTests"/>
        </classes>
    </test>

    <!-- Healthcare Capstone -->
    <test name="Healthcare Patient Tests">
        <classes>
            <class name="com.aitesting.healthcare.api.PatientTests"/>
        </classes>
    </test>

    <test name="Healthcare Encounter Tests">
        <classes>
            <class name="com.aitesting.healthcare.api.EncounterTests"/>
        </classes>
    </test>

    <test name="Healthcare Claim Tests">
        <classes>
            <class name="com.aitesting.healthcare.api.ClaimTests"/>
        </classes>
    </test>

    <test name="Healthcare Prior Auth Tests">
        <classes>
            <class name="com.aitesting.healthcare.api.PriorAuthTests"/>
        </classes>
    </test>

</suite>
